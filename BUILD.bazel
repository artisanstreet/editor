load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_lint_config", "rustfmt_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Cargo.Bazel.lock",
    "Cargo.lock",
    "Cargo.toml",
])

rust_lint_config(
    name = "workspace_lints",
    clippy = {
        "all": "deny",
        "pedantic": "deny",
    },
    rustc = {
        "unsafe_code": "forbid",
    },
)

rust_clippy(
    name = "clippy",
    testonly = True,
    deps = [
        "//modules/assets:assets",
        "//modules/backend:backend",
        "//modules/backend:forge",
        "//modules/database:database",
        "//modules/domain:domain",
        "//modules/frontend:editor",
        "//modules/frontend:frontend",
        "//modules/migrations:migrations",
        "//modules/protocol:protocol",
        "//modules/transport:transport",
        "//modules/ui:ui",
        "//scripts/capnp_codegen:capnpc_rust",
        "//tests/database:file_connection",
        "//tests/database:migrations",
        "//tests/database:seaorm_sqlite_proof",
        "//tests/domain:workspace_id_test",
        "//tests/policy:dependency_policy_test",
        "//tests/protocol:phase1_proof_test",
        "//tests/transport:loopback_test",
        "//tests/ui:markdown_seam_test",
    ],
)

rustfmt_test(
    name = "format_test",
    size = "small",
    targets = [
        "//modules/backend:forge",
        "//modules/frontend:editor",
        "//scripts/capnp_codegen:capnpc_rust",
        "//tests/database:file_connection",
        "//tests/database:migrations",
        "//tests/database:seaorm_sqlite_proof",
        "//tests/domain:workspace_id_test",
        "//tests/policy:dependency_policy_test",
        "//tests/protocol:phase1_proof_test",
        "//tests/transport:loopback_test",
        "//tests/ui:markdown_seam_test",
    ],
    transitive = True,
)

test_suite(
    name = "tests",
    tests = [
        ":format_test",
        "//tests/database:file_connection",
        "//tests/database:migrations",
        "//tests/database:seaorm_sqlite_proof",
        "//tests/domain:workspace_id_test",
        "//tests/policy:dependency_policy_test",
        "//tests/protocol:phase1_proof_test",
        "//tests/transport:loopback_test",
        "//tests/ui:markdown_seam_test",
    ],
)
