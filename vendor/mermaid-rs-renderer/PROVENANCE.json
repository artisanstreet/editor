    {
      "file": "src/text_metrics.rs",
      "reason": "Font-database measurement removed; text width always uses the built-in estimate."
    },
    {
      "file": "src/lib.rs",
      "reason": "cli module, run and write_output_png re-exports and their feature documentation removed."
    },
    {
      "file": "src/render.rs",
      "reason": "PNG output (write_output_png, resvg colour and font helpers and their tests) removed."
    }
