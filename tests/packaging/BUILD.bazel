load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_test", "rustfmt_test")

# Focused Phase 9 leaf: validates the layout-only portable runtime metadata
# contract against the existing Bazel-built Windows editor and Forge binaries.
#
# - `compile_data` embeds //packaging/portable:portable_layout.txt, so schema
#   drift fails compilation of this validator.
# - `data` wires //modules/frontend:editor and //modules/backend:forge as
#   runfiles; resolution is test-only (manifest or directory layout) with no
#   production fallback.
# - The test never launches either executable, touches no network, writes no
#   installer or user state, and claims no end-to-end workflow coverage:
#   installer, archive producer, updater, signing, distribution, supervisor,
#   authenticated handoff, and clean-host smoke remain deferred decisions.
rust_test(
    name = "portable_layout_test",
    srcs = ["portable_layout.rs"],
    compile_data = ["//packaging/portable:portable_layout.txt"],
    crate_name = "portable_layout_test",
    data = [
        "//modules/backend:forge",
        "//modules/frontend:editor",
    ],
    edition = "2024",
    lint_config = "//:workspace_lints",
    size = "small",
    visibility = ["//:__pkg__"],
)

# Closed v2 naming and path-safety contract for the approved versioned
# installation layout. This is a pure source-only proof: binary convergence,
# payload assembly, signing, installation, and launch behavior remain later
# packaging packets.
rust_test(
    name = "versioned_layout_test",
    srcs = ["versioned_layout.rs"],
    compile_data = ["//packaging/portable:versioned_layout.txt"],
    crate_name = "versioned_layout_test",
    edition = "2024",
    lint_config = "//:workspace_lints",
    size = "small",
    visibility = ["//:__pkg__"],
)

# Freezes the four Cargo output identities independently from Bazel target
# convergence. The manifests are compile-time inputs; the test never invokes
# Cargo, executes a binary, or inspects the host filesystem.
rust_test(
    name = "cargo_binary_identity_test",
    srcs = ["cargo_binary_identity.rs"],
    compile_data = [
        "//:modules/cli/Cargo.toml",
        "//:modules/installer/Cargo.toml",
        "//modules/backend:Cargo.toml",
        "//modules/frontend:Cargo.toml",
    ],
    crate_name = "cargo_binary_identity_test",
    edition = "2024",
    lint_config = "//:workspace_lints",
    size = "small",
    visibility = ["//:__pkg__"],
)

# Deterministic archive proof: validates the stored ZIP produced by
# //packaging/portable:portable_archive contains exactly the two Bazel-built
# binaries under contract-derived names with deterministic metadata.
# Layout proof and archive proof remain separate claim surfaces.
rust_test(
    name = "portable_archive_test",
    srcs = ["portable_archive.rs"],
    compile_data = ["//packaging/portable:portable_layout.txt"],
    crate_name = "portable_archive_test",
    data = [
        "//modules/backend:forge",
        "//modules/frontend:editor",
        "//packaging/portable:portable_archive",
        "//packaging/portable:portable_archive_reproducibility_fixture",
    ],
    edition = "2024",
    env = {
        "ARTISAN_PORTABLE_ARCHIVE": "$(rlocationpath //packaging/portable:portable_archive)",
        "ARTISAN_PORTABLE_ARCHIVE_REPRODUCIBILITY": "$(rlocationpath //packaging/portable:portable_archive_reproducibility_fixture)",
        "ARTISAN_PORTABLE_EDITOR_BINARY": "$(rlocationpath //modules/frontend:editor)",
        "ARTISAN_PORTABLE_FORGE_BINARY": "$(rlocationpath //modules/backend:forge)",
    },
    lint_config = "//:workspace_lints",
    size = "small",
    visibility = ["//:__pkg__"],
    deps = ["@rules_rust//rust/runfiles"],
)

# Package-local focused gates so this leaf stays self-contained. Root-level
# aggregate registration (// clippy / format_test / tests) remains a
# controller integration step and is intentionally not done here.
rust_clippy(
    name = "clippy",
    testonly = True,
    deps = [
        ":cargo_binary_identity_test",
        ":portable_archive_test",
        ":portable_layout_test",
        ":versioned_layout_test",
    ],
)

rustfmt_test(
    name = "format_test",
    size = "small",
    targets = [
        ":cargo_binary_identity_test",
        ":portable_archive_test",
        ":portable_layout_test",
        ":versioned_layout_test",
    ],
    transitive = True,
)

test_suite(
    name = "tests",
    tests = [
        ":cargo_binary_identity_test",
        ":portable_archive_test",
        ":portable_layout_test",
        ":versioned_layout_test",
    ],
)
