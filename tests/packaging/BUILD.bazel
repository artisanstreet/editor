load("@rules_rust//rust:defs.bzl", "rust_clippy", "rust_test", "rustfmt_test")
load("//packaging/release:release_manifest.bzl", "release_manifest")

# Closed v2 naming and path-safety contract for the approved versioned
# installation layout. This is a pure source-only proof: binary convergence,
# payload assembly, signing, installation, and launch behavior remain later
# packaging packets.
rust_test(
    name = "versioned_layout_test",
    srcs = ["versioned_layout.rs"],
    compile_data = ["//packaging/portable:versioned_layout.txt"],
    crate_name = "versioned_layout_test",
    edition = "2024",
    lint_config = "//:workspace_lints",
    size = "small",
    visibility = ["//:__pkg__"],
)

# Freezes the four Cargo output identities independently from Bazel target
# convergence. The manifests are compile-time inputs; the test never invokes
# Cargo, executes a binary, or inspects the host filesystem.
rust_test(
    name = "cargo_binary_identity_test",
    srcs = ["cargo_binary_identity.rs"],
    compile_data = [
        "//modules/cli:Cargo.toml",
        "//modules/installer:Cargo.toml",
        "//modules/backend:Cargo.toml",
        "//modules/frontend:Cargo.toml",
    ],
    crate_name = "cargo_binary_identity_test",
    edition = "2024",
    lint_config = "//:workspace_lints",
    size = "small",
    visibility = ["//:__pkg__"],
)

# Deterministic archive proof: validates the stored ZIP produced by
# //packaging/portable:versioned_payload_archive contains exactly the four
# authoritative Bazel binaries and generated payload manifest at the version
# payload root. The archive is also compared with an independently named
# action so output paths cannot influence the bytes.
rust_test(
    name = "versioned_payload_archive_test",
    srcs = ["portable_archive.rs"],
    compile_data = ["//packaging/portable:versioned_layout.txt"],
    crate_name = "versioned_payload_archive_test",
    data = [
        "//modules/cli:ae",
        "//modules/frontend:editor",
        "//modules/backend:forge",
        "//modules/installer:installer",
        "//packaging/portable:versioned_payload_archive",
        "//packaging/portable:versioned_payload_archive_reproducibility_fixture",
    ],
    edition = "2024",
    env = {
        "ARTISAN_VERSIONED_PAYLOAD_ARCHIVE": "$(rlocationpath //packaging/portable:versioned_payload_archive)",
        "ARTISAN_VERSIONED_PAYLOAD_ARCHIVE_REPRODUCIBILITY": "$(rlocationpath //packaging/portable:versioned_payload_archive_reproducibility_fixture)",
        "ARTISAN_VERSIONED_PAYLOAD_AE_BINARY": "$(rlocationpath //modules/cli:ae)",
        "ARTISAN_VERSIONED_PAYLOAD_EDITOR_BINARY": "$(rlocationpath //modules/frontend:editor)",
        "ARTISAN_VERSIONED_PAYLOAD_FORGE_BINARY": "$(rlocationpath //modules/backend:forge)",
        "ARTISAN_VERSIONED_PAYLOAD_INSTALLER_BINARY": "$(rlocationpath //modules/installer:installer)",
    },
    lint_config = "//:workspace_lints",
    size = "small",
    visibility = ["//:__pkg__"],
    deps = [
        "@crates//:serde_json",
        "@crates//:sha2-0.10.9",
        "@rules_rust//rust/runfiles",
    ],
)

# Negative producer fixtures that cannot be expressed as successful archive
# targets run the exact hermetic manifest generator's pure validation tests.
rust_test(
    name = "payload_manifest_test",
    crate = "//packaging/portable:payload_manifest_generator",
    crate_name = "payload_manifest_test",
    edition = "2024",
    lint_config = "//:workspace_lints",
    size = "small",
    visibility = ["//:__pkg__"],
)

# Source-level boundary proof: the packaging rule exposes only public metadata
# and one archive to generate, while signing remains a runtime-only tool mode.
rust_test(
    name = "release_manifest_test",
    srcs = ["release_manifest.rs"],
    compile_data = [
        "BUILD.bazel",
        "//packaging/release:release_manifest.bzl",
        "//packaging/release:rust/release_tool.rs",
    ],
    crate_name = "release_manifest_test",
    edition = "2024",
    lint_config = "//:workspace_lints",
    size = "small",
    visibility = ["//:__pkg__"],
)

release_manifest(
    name = "development_release_manifest",
    archive = "//packaging/portable:versioned_payload_archive",
    format_version = 1,
    product_version = "0.0.0",
    editor_forge_compatibility_version = "0.0.0",
    channel = "nightly",
    signing_key_id = "development",
    algorithm = "ed25519",
    minimum_installer_version = "0.0.0",
    minimum_cli_version = "0.0.0",
    artifact_id = "windows-x64",
    platform = "windows",
    architecture = "x64",
    libc = "",
    archive_format = "zip",
    file_name = "artisan-editor-versioned-payload.zip",
    output_name = "release-manifest.json",
    visibility = ["//:__pkg__"],
)

# Package-local focused gates so this leaf stays self-contained. Root-level
# aggregate registration (// clippy / format_test / tests) remains a
# controller integration step and is intentionally not done here.
rust_clippy(
    name = "clippy",
    testonly = True,
    deps = [
        ":cargo_binary_identity_test",
        ":payload_manifest_test",
        ":release_manifest_test",
        ":versioned_layout_test",
        ":versioned_payload_archive_test",
    ],
)

rustfmt_test(
    name = "format_test",
    size = "small",
    targets = [
        ":cargo_binary_identity_test",
        ":payload_manifest_test",
        ":release_manifest_test",
        ":versioned_layout_test",
        ":versioned_payload_archive_test",
    ],
    transitive = True,
)

test_suite(
    name = "tests",
    tests = [
        ":cargo_binary_identity_test",
        ":payload_manifest_test",
        ":release_manifest_test",
        ":versioned_layout_test",
        ":versioned_payload_archive_test",
    ],
)
