# Private backend tests compile as cfg(test) modules of the backend crate
# itself (including the helper's path-linked tests), so this target builds
# the backend crate root in test mode with no separate sources: rules_rust
# crate and srcs are incompatible. The TEST-ONLY fixture executable rides
# along as declared data, resolved through the pinned official runfiles
# library via its exact rlocationpath.
rust_test(
    name = "backend_unit_test",
    crate = "//modules/backend:backend",
    data = [
        ":directory_controller_fixture",
        ":engine_owner_fixture",
    ],
    deps = [
        "@crates//:rcgen",
        "@crates//:rustls-pki-types",
        "@rules_rust//rust/runfiles",
    ],
    env = {
        "ARTISAN_DIRECTORY_CONTROLLER_FIXTURE": "$(rlocationpath :directory_controller_fixture)",
        "ARTISAN_ENGINE_OWNER_FIXTURE": "$(rlocationpath :engine_owner_fixture)",
    },
    lint_config = "//:workspace_lints",
    size = "small",
    visibility = ["//:__pkg__"],
)

