load("@rules_rust//rust:defs.bzl", "rust_test")

# Contract-named helper test sources are exported so the backend package can
# declare them as library source inputs; they compile as private cfg(test)
# modules of the backend crate, not as standalone integration crates.
exports_files([
    "directory_helper.rs",
    "directory_helper_fixture.rs",
    "directory_helper_unit.rs",
    "listener_configuration.rs",
])

rust_test(
    name = "listener_test",
    srcs = ["listener.rs"],
    crate_name = "listener_test",
    deps = [
        "//modules/backend:backend",
        "//modules/database:database",
        "//modules/domain:domain",
        "//modules/protocol:protocol",
        "//modules/transport:transport",
        "@crates//:getrandom",
        "@crates//:quinn",
        "@crates//:rcgen",
        "@crates//:rustls-pki-types",
        "@crates//:tokio",
    ],
    edition = "2024",
    lint_config = "//:workspace_lints",
    size = "small",
    visibility = ["//:__pkg__"],
)

rust_test(
    name = "app_test",
    srcs = ["app.rs"],
    crate_name = "app_test",
    deps = [
        "//modules/backend:backend",
        "//modules/database:database",
        "//modules/domain:domain",
        "@crates//:tokio",
    ],
    edition = "2024",
    lint_config = "//:workspace_lints",
    size = "small",
    visibility = ["//:__pkg__"],
)

# Private backend tests compile as cfg(test) modules of the backend crate
# itself (including the helper's path-linked tests), so this target builds
# the backend crate root in test mode with no separate sources: rules_rust
# crate and srcs are incompatible.
rust_test(
    name = "backend_unit_test",
    crate = "//modules/backend:backend",
    deps = [
        "@crates//:rcgen",
        "@crates//:rustls-pki-types",
    ],
    lint_config = "//:workspace_lints",
    size = "small",
    visibility = ["//:__pkg__"],
)

