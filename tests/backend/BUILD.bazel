# Contract-named helper/controller test sources are exported so the backend
# package can declare them as library source inputs; they compile as private
# cfg(test) modules of the backend crate, not as standalone integration
# crates.
exports_files([
    "directory_controller.rs",
    "directory_helper.rs",
    "directory_helper_fixture.rs",
    "directory_helper_unit.rs",
    "engine_owner_configuration.rs",
    "engine_owner_custody.rs",
    "engine_owner_readiness.rs",
    "engine_owner_streaming.rs",
    "listener_configuration.rs",
])

# TEST-ONLY protocol child fixture: one ordinary main, no libtest harness,
# no banner. It path-links the ACTUAL shared private codec source exported
# by //modules/backend and depends on domain plus the codec's own pinned
# thiserror macro dependency. Never shipped; exactly two shipping binaries
# remain (editor frontend + forge).
rust_binary(
    name = "directory_controller_fixture",
    srcs = [
        "//modules/backend:src/directory_helper_codec.rs",
        "directory_controller_fixture.rs",
    ],
    crate_name = "directory_controller_fixture",
    deps = [
        "//modules/domain:domain",
        "@crates//:thiserror",
    ],
    edition = "2024",
    lint_config = "//:workspace_lints",
    testonly = True,
    visibility = ["//:__pkg__"],
)

