load("@rules_rust//rust:defs.bzl", "rust_test")

# White-box unit tests for the ui library's private tinted-route helper.
# The file is compiled as a cfg(test) child module of `crate::asset_seam`
# (declared there), and the `tinted_svg_unit_test` target in
# //modules/ui/BUILD.bazel builds it via `crate = ":ui"`.
exports_files(
    ["tinted_svg.rs"],
    visibility = ["//visibility:public"],
)

