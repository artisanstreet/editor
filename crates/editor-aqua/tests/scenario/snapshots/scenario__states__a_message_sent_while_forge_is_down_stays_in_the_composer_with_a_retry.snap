---
source: crates/editor-aqua/tests/scenario/states.rs
expression: "editor.settle(\"the failure to show\", |view|\n{ view.shows(\"Couldn't\") && view.find(Role::Button, \"Try again\").is_some() })"
---
Group "Artisan Editor"
  Button "Hide sidebar"
  TextInput "Search threads"
  Button "New thread"
  List
    ListItem
      Group "Project"
        Label "Project"
    ListItem
      Button "Greeting" [selected]
        Label "Greeting"
  Button "Search threads"
  Button "New thread"
  Button "Test" [collapsed]
    Label "Test"
  Group "Project / Greeting"
    Group "Project / Greeting"
      Button "New thread in Project"
        Label "Project"
      Label "/"
      Label "Greeting"
  Button "Minimize window"
  Button "Maximize window"
  Button "Close window"
  Label "No messages yet."
  ComboBox "No model" [collapsed]
    Label "No model"
  Group [focused]
    Label "Couldn't save the draft: PUT /drafts/thread:thread-a"
    Button "Try again"
      Label "Try again"
  ScrollView
    TextInput "Message" value="Say hello"
  Button "Send message"
