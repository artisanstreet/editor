    Group "Claude Code"
      Label "Claude Code"
    Label "Claude Code is not ready: signed out."
    Button "Sign in to Claude Code"
      Label "Sign in to Claude Code"
    Group "Codex"
      Label "Codex"
    Label "Codex is not ready: not installed."
    Button "Install Codex"
      Label "Install Codex"
    Group "OpenCode"
      Label "OpenCode"
    Label "OpenCode is not ready: not installed."
    Button "Install OpenCode"
      Label "Install OpenCode"
    Group "Antigravity"
