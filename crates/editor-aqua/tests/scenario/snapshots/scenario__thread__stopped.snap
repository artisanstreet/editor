---
source: crates/editor-aqua/tests/scenario/thread.rs
expression: "editor.settle(\"the turn to stop\", |view|\n{\n    view.find(Role::Button, \"Continue where it stopped\").is_some() &&\n    view.shows(\"Stopped after\")\n})"
---
Group "Artisan Editor"
  Button "Hide sidebar"
  TextInput "Search threads"
  Button "New thread"
  List
    ListItem
      Group "Project"
        Label "Project"
    ListItem
      Button "Parser" [selected]
        Label "Parser"
  Button "Test" [collapsed]
    Label "Test"
  Group "Project / Parser"
    Group "Project / Parser"
      Button "New thread in Project"
        Label "Project"
      Label "/"
      Label "Parser"
  Button "Minimize window"
  Button "Maximize window"
  Button "Close window"
  List
    ListItem
      Group "You"
        Label "Refactor the parser"
    ListItem
      Label "Stopped after [duration]"
  Label "Reply stopped"
  ComboBox "No model" [collapsed]
    Label "No model"
  ScrollView
    TextInput "Message" [focused]
  Button "Continue where it stopped"
