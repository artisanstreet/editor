  Button "New thread"
  List
    ListItem
      Group "Project"
        Label "Project"
    ListItem
      Button "Greeting" [selected]
        Label "Greeting"
  Button "Search threads"
  Button "New thread"
  Button "Test" [collapsed]
    Label "Test"
  Group "Project / Greeting"
