---
source: crates/editor-aqua/tests/scenario/settings.rs
expression: "editor.settle_part(\"the Claude Code page\", Role::Dialog, Some(\"Settings\"),\n|view| view.shows(\"claude.ai session\"))"
---
Dialog "Settings"
  ScrollView
    Group "Editor"
      Label "Editor"
    Button "General"
      Label "General"
    Button "Account"
      Label "Account"
    Button "Forges"
      Label "Forges"
    Button "About"
      Label "About"
    Group "Forge"
      Label "Forge"
    Button "Threads"
      Label "Threads"
    Button "Extensions"
      Label "Extensions"
    Group "Engines"
      Label "Engines"
    Button "Claude Code" [selected, focused]
      Label "Claude Code"
      Label "Sign in"
    Button "Installation"
      Label "Installation"
    Button "Account"
      Label "Account"
    Button "claude.ai mode"
      Label "claude.ai mode"
    Button "Codex"
      Label "Codex"
      Label "Install"
    Button "OpenCode"
      Label "OpenCode"
      Label "Install"
    Button "Antigravity"
      Label "Antigravity"
      Label "Install"
  Button "Close settings"
  ScrollView
    Heading "Claude Code"
    Label "Claude Code's installation and sign-in on this Forge."
    Heading "Installation"
    Button "Refresh"
      Label "Refresh"
    Label "Claude Code 1.0.0 is installed and managed by this Forge."
    Group "Version"
      Label "Version"
      Label "Follows the latest release (1.0.0)."
      Button "Roll back"
        Label "Roll back"
      Button "Choose version"
        Label "Choose version"
    Label "Verified by the vendor's published checksum."
    Heading "Account"
    Button "Refresh"
      Label "Refresh"
    Label "Couldn't read the account status."
    Label "Details"
    Group "Sign in"
      Label "Sign in"
      Label "Claude Code can't run until you sign in."
      Button "Sign in"
        Label "Sign in"
    Heading "claude.ai mode"
    Group "claude.ai mode"
      Label "claude.ai mode"
      Label "Run Claude through claude.ai with local files, commands, skills, MCP servers and subagents. Turn this off to use Claude Code."
      Switch "claude.ai mode" [unchecked]
    Group "claude.ai session"
      Label "claude.ai session"
      Label "Not signed in. Signing in opens claude.ai in a browser window; it closes by itself once you're in."
      Button "Sign in"
        Label "Sign in"
