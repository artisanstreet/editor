---
source: crates/editor-aqua/tests/scenario/settings.rs
expression: "editor.settle_part(\"the Claude Code page\", Role::Dialog, Some(\"Settings\"),\n|view| view.shows(\"claude.ai session\"))"
---
Dialog "Settings"
  ScrollView
    Group "Editor"
      Label "Editor"
    Button "General" [collapsed]
      Label "General"
    Button "Account"
      Label "Account"
    Button "Forges"
      Label "Forges"
    Button "About"
      Label "About"
    Group "Forge"
      Label "Forge"
    Button "Threads" [collapsed]
      Label "Threads"
    Button "Extensions" [collapsed]
      Label "Extensions"
    Group "Engines"
      Label "Engines"
    Button "Claude Code" [expanded, focused]
      Label "Claude Code"
      Label "Sign in"
    Button "Installation"
      Label "Installation"
    Button "Account"
      Label "Account"
    Button "claude.ai mode"
      Label "claude.ai mode"
    Button "Codex" [collapsed]
      Label "Codex"
      Label "Install"
    Button "OpenCode" [collapsed]
      Label "OpenCode"
      Label "Install"
  Button "Close settings"
  ScrollView
    Label "Claude Code"
    Label "Claude Code's installation and sign-in on this Forge."
    Label "Installation"
    Button "Refresh"
      Label "Refresh"
    Label "Claude Code 1.0.0 is installed and managed by this Forge."
    Group "Version"
      Label "Version"
      Label "Follows the latest release (1.0.0)."
      Button "Roll back"
        Label "Roll back"
      Button "Choose version"
        Label "Choose version"
    Label "Verified by the vendor's published checksum."
    Label "Account"
    Button "Refresh"
      Label "Refresh"
    Label "Account status unavailable: Claude Code sign-in status is unavailable: the replaying engine only runs turns, not [\"auth\", \"status\"]."
    Group "Sign in"
      Label "Sign in"
      Label "Claude Code can't run until you sign in."
      Button "Sign in"
        Label "Sign in"
    Label "claude.ai mode"
    Group "claude.ai mode"
      Label "claude.ai mode"
      Label "Run Claude through claude.ai with local files, commands, skills, MCP servers and subagents. Turn this off to use Claude Code."
      Switch "switch enhanced claude" [unchecked]
    Group "claude.ai session"
      Label "claude.ai session"
      Label "Not signed in. Signing in opens claude.ai in a browser window; it closes by itself once you're in."
      Button "Sign in"
        Label "Sign in"
