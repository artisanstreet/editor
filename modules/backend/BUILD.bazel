load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")

exports_files(["Cargo.toml"])

rust_library(
    name = "backend",
    srcs = [
        "src/app.rs",
        "src/connection.rs",
        "src/credential_authority.rs",
        "src/command_admission.rs",
        "src/directory_helper.rs",
        "src/directory_helper_codec.rs",
        "src/directory_selection.rs",
        "src/lib.rs",
        "src/request_handler.rs",
        "src/storage.rs",
        "//tests/backend:directory_helper.rs",
        "//tests/backend:directory_helper_fixture.rs",
        "//tests/backend:directory_helper_unit.rs",
    ],
    crate_name = "artisan_backend",
    deps = [
        "//modules/database:database",
        "//modules/domain:domain",
        "//modules/migrations:migrations",
        "//modules/protocol:protocol",
        "//modules/transport:transport",
        "@crates//:getrandom",
        "@crates//:quinn",
        "@crates//:sea-orm",
        "@crates//:thiserror",
        "@crates//:tokio",
        "@crates//:zeroize",
    ] + select({
        "@platforms//os:windows": ["@crates//:native-dialog"],
        "//conditions:default": [],
    }),
    edition = "2024",
    lint_config = "//:workspace_lints",
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "forge",
    srcs = ["src/main.rs"],
    crate_name = "artisan_forge",
    deps = [":backend"],
    edition = "2024",
    lint_config = "//:workspace_lints",
    visibility = ["//visibility:public"],
)
