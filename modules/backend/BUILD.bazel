load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")

# The exact shared private codec source is exported so the TEST-ONLY
# directory-controller fixture can path-link it without duplicating the
# encoder or depending on the backend library.
exports_files(
    [
        "Cargo.toml",
        "src/directory_helper_codec.rs",
    ],
)

rust_library(
    name = "backend",
    srcs = [
        "src/agent_name_allocation_policy.rs",
        "src/app.rs",
        "src/builtin_tool_capabilities_policy.rs",
        "src/connection.rs",
        "src/credential_authority.rs",
        "src/command_admission.rs",
        "src/directory_controller.rs",
        "src/directory_controller/operation.rs",
        "src/directory_controller/process.rs",
        "src/directory_helper.rs",
        "src/directory_helper_codec.rs",
        "src/directory_selection.rs",
        "src/engine_owner/mod.rs",
        "src/engine_owner/operation.rs",
        "src/engine_owner/process.rs",
        "src/engine_owner/readiness.rs",
        "src/engine_owner/http.rs",
        "src/engine_owner/stream.rs",
        "src/engine_owner/event.rs",
        "src/engine_owner/framing.rs",
        "src/engine_owner/observation.rs",
        "src/lib.rs",
        "src/listener.rs",
        "src/preview_service_policy.rs",
        "src/request_handler.rs",
        "src/storage.rs",
        "//tests/backend:directory_controller.rs",
        "//tests/backend:directory_helper.rs",
        "//tests/backend:directory_helper_fixture.rs",
        "//tests/backend:directory_helper_unit.rs",
        "//tests/backend:engine_owner_configuration.rs",
        "//tests/backend:engine_owner_custody.rs",
        "//tests/backend:engine_owner_readiness.rs",
        "//tests/backend:engine_owner_streaming.rs",
        "//tests/backend:listener_configuration.rs",
    ],
    crate_name = "artisan_backend",
    deps = [
        "//modules/database:database",
        "//modules/domain:domain",
        "//modules/migrations:migrations",
        "//modules/protocol:protocol",
        "//modules/transport:transport",
        "@crates//:base64",
        "@crates//:bytes",
        "@crates//:getrandom",
        "@crates//:http",
        "@crates//:http-body-util",
        "@crates//:hyper",
        "@crates//:hyper-util",
        "@crates//:quinn",
        "@crates//:sea-orm",
        "@crates//:serde_json",
        "@crates//:thiserror",
        "@crates//:tokio",
        "@crates//:zeroize",
    ] + select({
        "@platforms//os:windows": ["@crates//:native-dialog"],
        "//conditions:default": [],
    }),
    edition = "2024",
    lint_config = "//:workspace_lints",
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "forge",
    srcs = ["src/main.rs"],
    crate_name = "artisan_forge",
    deps = [":backend"],
    edition = "2024",
    lint_config = "//:workspace_lints",
    visibility = ["//visibility:public"],
)
