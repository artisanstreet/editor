# Embedded variable typefaces (see fonts/FONTS.md for the manifest). Kept in
# a separate list from ASSET_SOURCES/LICENSE_DOCS on purpose: the
# //tests/assets bijection pins those two lists at exactly 104/9 entries, and
# fonts are binary TrueType, not SVG catalog rows.
FONT_FILES = [
    "fonts/artisan-neo-variable.ttf",
    "fonts/cal-sans-variable.ttf",
    "fonts/jetbrains-mono-variable.ttf",
    "fonts/sigurd-artisan.ttf",
]

FONT_LICENSES = [
    "licenses/artisan-neo-OFL.txt",
    "licenses/cal-sans-OFL.txt",
    "licenses/jetbrains-mono-OFL.txt",
    "licenses/sigurd-artisan-NOTES.md",
]

rust_library(
    name = "assets",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["manifest.toml"] + ASSET_SOURCES + LICENSE_DOCS + FONT_FILES + FONT_LICENSES,
    crate_name = "artisan_assets",
    edition = "2024",
    lint_config = "//:workspace_lints",
    visibility = ["//visibility:public"],
)

# Validation-only runfiles: every physical SVG (glob so missing or extra
# files break the bijection test), this BUILD file itself (so the external
# validator can parse the explicit lists), the raw manifest, and every
# license document. Consumed only by //tests/assets through `data`.
filegroup(
    name = "asset_validation_files",
    srcs = glob(["svg/**/*.svg"]) + ["manifest.toml", "BUILD.bazel"] + LICENSE_DOCS,
    visibility = ["//tests/assets:__pkg__"],
)
