# Raw-byte identity for the vendored asset corpus: SVG sources and this
# manifest are pinned to LF so recorded sha256 digests over the exact raw
# checked-in bytes hold on every platform. Subtree-scoped by design.
svg/**/*.svg text eol=lf
manifest.toml text eol=lf
# TrueType binaries must never see line-ending conversion.
fonts/**/*.ttf binary
fonts/FONTS.md text eol=lf
