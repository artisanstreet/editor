load(
    "@rules_rust//rust:defs.bzl",
    "rust_binary",
    "rust_clippy",
    "rust_library",
    "rust_test",
    "rustfmt_test",
)

exports_files(["Cargo.toml"])

rust_library(
    name = "cli",
    srcs = [
        "rust/commands.rs",
        "rust/credentials.rs",
        "rust/error.rs",
        "rust/http.rs",
        "rust/instance.rs",
        "rust/lib.rs",
        "rust/manifest.rs",
        "rust/paths.rs",
        "rust/payload.rs",
        "rust/process.rs",
        "rust/telemetry.rs",
    ],
    crate_name = "artisan_editor_cli",
    deps = [
        "@crates//:base64",
        "@crates//:clap",
        "@crates//:fs2",
        "@crates//:getrandom-0.3.4",
        "@crates//:rcgen",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2-0.10.9",
        "@crates//:thiserror",
        "@crates//:winapi-util",
        "@crates//:zeroize",
    ],
    edition = "2024",
    lint_config = "//:workspace_lints",
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "ae",
    srcs = ["rust/main.rs"],
    crate_name = "ae",
    deps = [
        ":cli",
        "@crates//:clap",
    ],
    edition = "2024",
    lint_config = "//:workspace_lints",
    visibility = ["//visibility:public"],
)

rust_test(
    name = "cli_unit_test",
    crate = ":cli",
    deps = ["@crates//:tempfile"],
    env = {
        "LOCALAPPDATA": "C:\\ArtisanBazelTestLocalAppData",
    },
    edition = "2024",
    lint_config = "//:workspace_lints",
    size = "small",
    visibility = ["//:__pkg__"],
)

rust_clippy(
    name = "clippy",
    testonly = True,
    deps = [
        ":ae",
        ":cli",
        ":cli_unit_test",
    ],
)

rustfmt_test(
    name = "format_test",
    size = "small",
    targets = [
        ":ae",
        ":cli",
        ":cli_unit_test",
    ],
    transitive = True,
)

test_suite(
    name = "tests",
    tests = [":cli_unit_test"],
)
