load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")

exports_files(["Cargo.toml"])

rust_library(
    name = "frontend",
    srcs = [
        "src/attention.rs",
        "src/composer.rs",
        "src/context_usage_tone.rs",
        "src/conversation_diff_stat.rs",
        "src/conversation_projection.rs",
        "src/conversation_projection/validation.rs",
        "src/image_viewer.rs",
        "src/lib.rs",
        "src/proof.rs",
        "src/project_picker.rs",
        "src/reasoning_display.rs",
        "src/shell.rs",
        "src/subscription_projection.rs",
        "src/thread_list_selection.rs",
        "src/transcript.rs",
    ],
    crate_name = "artisan_frontend",
    deps = [
        "//modules/assets:assets",
        "//modules/domain:domain",
        "//modules/protocol:protocol",
        "//modules/transport:transport",
        "//modules/ui:ui",
        "@crates//:gpui",
    ],
    edition = "2024",
    lint_config = "//:workspace_lints",
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "editor",
    srcs = ["src/main.rs"],
    crate_name = "artisan_editor",
    deps = [":frontend"],
    edition = "2024",
    lint_config = "//:workspace_lints",
    visibility = ["//visibility:public"],
)
