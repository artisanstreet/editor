load("@rules_rust//rust:defs.bzl", "rust_library")

exports_files(["Cargo.toml"])

rust_library(
    name = "catalog",
    srcs = [
        "rust/lib.rs",
        "rust/manifest.rs",
        "rust/policy.rs",
        "rust/validation.rs",
        "rust/wire.rs",
        "rust/wire/decode.rs",
        "rust/wire/encode.rs",
        "rust/wire/validate.rs",
    ],
    compile_data = ["rust/native_model_catalog.json"],
    crate_name = "artisan_catalog",
    crate_root = "rust/lib.rs",
    deps = [
        "@crates//:serde_json",
        "@crates//:thiserror",
    ],
    edition = "2024",
    lint_config = "//:workspace_lints",
    visibility = ["//visibility:public"],
)
