{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"exactOptionalPropertyTypes": true,
		"lib": ["ES2024"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"noImplicitOverride": true,
		"noUncheckedIndexedAccess": true,
		"paths": {
			"@artisan/catalog": ["./modules/catalog/src/index.ts"],
			"@artisan/backend": ["./modules/backend/src/index.ts"],
			"@artisan/bootstrap": ["./modules/bootstrap/src/index.ts"],
			"@artisan/cli": ["./modules/cli/src/index.ts"],
			"@artisan/desktop": ["./modules/desktop/src/index.ts"],
			"@artisan/distribution": ["./modules/distribution/src/index.ts"],
			"@artisan/engines": ["./modules/engines/src/index.ts"],
			"@artisan/forge": ["./modules/forge/src/index.ts"],
			"@artisan/protocol": ["./modules/protocol/src/index.ts"],
			"@artisan/transport": ["./modules/transport/src/index.ts"],
			"@artisan/transport/*": ["./modules/transport/src/*.ts"]
		},
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2024",
		"types": ["node", "vitest/globals"],
		"verbatimModuleSyntax": true
	},
	"include": ["modules/**/*.ts", ".tests/**/*.ts", "drizzle.config.ts", "vitest.config.ts"],
	"exclude": ["modules/frontend/**"]
}
