package(default_visibility = ["//visibility:public"])

exports_files(["gpui-blur.patch"])

load("@rules_rust//rust:defs.bzl", "rust_binary")

# Visual-proof demo for the D3D11 backdrop-blur pass (B2). Tri-band
# backdrop with a 16px blurred card; run the binary and screenshot it.
rust_binary(
    name = "backdrop_blur_demo",
    srcs = ["gpui/examples/backdrop_blur.rs"],
    edition = "2024",
    deps = ["@crates//:gpui"],
)

# Visual-proof harness: mock transcript screen for screenshots. Renders
# two turns through the real ConversationSurface with hardcoded scene
# data (no Forge). NOT shipped in any payload.
rust_binary(
    name = "screen_demo",
    srcs = ["screen_demo.rs"],
    compile_data = [
        "fonts/JetBrainsMono-Bold.ttf",
        "fonts/JetBrainsMono-Italic.ttf",
        "fonts/JetBrainsMono-Regular.ttf",
    ],
    edition = "2024",
    deps = [
        "//modules/domain:domain",
        "//modules/frontend:frontend",
        "//modules/ui:ui",
        "@crates//:gpui",
    ],
)
