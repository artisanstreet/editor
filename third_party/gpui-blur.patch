+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{Background, BorderStyle, point, size};
+
+    fn scaled(value: f32) -> ScaledPixels {
+        ScaledPixels::from(value)
+    }
+
+    fn test_bounds(x: f32) -> Bounds<ScaledPixels> {
+        Bounds::new(
+            point(scaled(x), scaled(0.)),
+            size(scaled(100.), scaled(100.)),
+        )
+    }
+
+    fn test_mask() -> ContentMask<ScaledPixels> {
+        ContentMask {
+            bounds: Bounds::new(
+                point(scaled(-1000.), scaled(-1000.)),
+                size(scaled(100_000.), scaled(100_000.)),
+            ),
+        }
+    }
+
+    fn test_shadow(x: f32) -> Shadow {
+        Shadow {
+            order: 0,
+            blur_radius: scaled(4.),
+            bounds: test_bounds(x),
+            corner_radii: Corners::default(),
+            content_mask: test_mask(),
+            color: Hsla::default(),
+        }
+    }
+
+    fn test_blur(x: f32, radius: f32) -> BlurRect {
+        BlurRect {
+            order: 0,
+            blur_radius: scaled(radius),
+            bounds: test_bounds(x),
+            corner_radii: Corners::default(),
+            content_mask: test_mask(),
+        }
+    }
+
+    fn test_quad(x: f32) -> Quad {
+        Quad {
+            order: 0,
+            border_style: BorderStyle::default(),
+            bounds: test_bounds(x),
+            content_mask: test_mask(),
+            background: Background::default(),
+            border_color: Hsla::default(),
+            corner_radii: Corners::default(),
+            border_widths: Edges::default(),
+        }
+    }
+
+    fn batch_summary(scene: &Scene) -> Vec<String> {
+        scene
+            .batches()
+            .map(|batch| match batch {
+                PrimitiveBatch::Shadows(shadows) => format!("shadows:{}", shadows.len()),
+                PrimitiveBatch::BlurRects(blurs) => {
+                    let radii: Vec<String> = blurs
+                        .iter()
+                        .map(|blur| format!("{:?}", blur.blur_radius))
+                        .collect();
+                    format!("blurs:{}:{}", blurs.len(), radii.join(","))
+                }
+                PrimitiveBatch::Quads(quads) => format!("quads:{}", quads.len()),
+                batch => panic!("unexpected batch in blur ordering test: {batch:?}"),
+            })
+            .collect()
+    }
+
+    #[test]
+    fn blur_rects_sort_after_shadows_and_before_quads_in_draw_order() {
+        let mut scene = Scene::default();
+
+        // First layer takes draw order 1.
+        scene.push_layer(test_bounds(0.));
+        scene.insert_primitive(test_shadow(0.));
+        scene.insert_primitive(test_blur(0., 4.));
+        scene.insert_primitive(test_quad(0.));
+        scene.pop_layer();
+
+        // Overlapping second layer takes draw order 2.
+        scene.push_layer(test_bounds(50.));
+        scene.insert_primitive(test_blur(50., 12.));
+        scene.insert_primitive(test_quad(50.));
+        scene.pop_layer();
+
+        scene.finish();
+
+        assert_eq!(scene.blur_rects.len(), 2);
+        assert!(scene.blur_rects[0].order < scene.blur_rects[1].order);
+
+        assert_eq!(
+            batch_summary(&scene),
+            vec![
+                "shadows:1".to_string(),
+                format!("blurs:1:{:?}", scaled(4.)),
+                "quads:1".to_string(),
+                format!("blurs:1:{:?}", scaled(12.)),
+                "quads:1".to_string(),
+            ]
+        );
+    }
+
+    #[test]
+    fn blur_rects_with_empty_clipped_bounds_are_skipped() {
+        let mut scene = Scene::default();
+
+        let mut clipped = test_blur(0., 8.);
+        clipped.content_mask = ContentMask {
+            bounds: test_bounds(1000.),
+        };
+        scene.insert_primitive(clipped);
+
+        assert_eq!(scene.len(), 0);
+        assert!(scene.blur_rects.is_empty());
+
+        scene.insert_primitive(test_blur(0., 8.));
+        assert_eq!(scene.len(), 1);
+        assert_eq!(scene.blur_rects.len(), 1);
+        assert_eq!(scene.blur_rects[0].blur_radius, scaled(8.));
+    }
+}
