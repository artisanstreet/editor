+        scene.push_layer(test_bounds(0.));
+        scene.insert_primitive(test_shadow(0.));
+        scene.insert_primitive(test_blur(0., 4.));
+        scene.insert_primitive(test_quad(0.));
+        scene.pop_layer();
+
+        // Overlapping second layer takes draw order 2.
+        scene.push_layer(test_bounds(50.));
+        scene.insert_primitive(test_blur(50., 12.));
+        scene.insert_primitive(test_quad(50.));
+        scene.pop_layer();
+
+        scene.finish();
+
+        assert_eq!(scene.blur_rects.len(), 2);
+        assert!(scene.blur_rects[0].order < scene.blur_rects[1].order);
+
+        assert_eq!(
