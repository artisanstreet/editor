+    #[gpui::test]
+    async fn style_paint_emits_blur_before_the_background_quad(cx: &mut TestAppContext) {
+        use crate::{AvailableSpace, PrimitiveBatch, div, point, size};
+
+        let cx = cx.add_empty_window();
+        cx.draw(
+            point(px(0.), px(0.)),
+            size(
+                AvailableSpace::Definite(px(200.)),
+                AvailableSpace::Definite(px(200.)),
+            ),
+            |_, _| {
+                div()
+                    .w(px(200.))
+                    .h(px(200.))
+                    .bg(red())
+                    .backdrop_blur(px(8.))
+            },
+        );
+
+        cx.update(|window, _| {
+            // `draw` above leaves the window dirty, so its own update cycle
+            // runs a full frame: the painted scene is finished and swapped
+            // into `rendered_frame` while `next_frame` is cleared.
+            let scale_factor = window.scale_factor();
+            let scene = &window.rendered_frame.scene;
+
+            assert_eq!(scene.blur_rects.len(), 1);
+            assert_eq!(scene.quads.len(), 1);
+            assert_eq!(scene.blur_rects[0].blur_radius, px(8.).scale(scale_factor));
+            assert_eq!(scene.blur_rects[0].bounds, scene.quads[0].bounds);
+
+            let summary: Vec<String> = scene
+                .batches()
+                .map(|batch| match batch {
+                    PrimitiveBatch::BlurRects(blurs) => format!("blurs:{}", blurs.len()),
+                    PrimitiveBatch::Quads(quads) => format!("quads:{}", quads.len()),
+                    batch => panic!("unexpected batch in backdrop blur paint test: {batch:?}"),
+                })
+                .collect();
+            assert_eq!(summary, vec!["blurs:1".to_string(), "quads:1".to_string()]);
+        });
