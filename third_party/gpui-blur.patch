+    #[test]
+    fn blur_rects_sort_after_shadows_and_before_quads_in_draw_order() {
+        let mut scene = Scene::default();
+
+        // First layer takes draw order 1.
+        scene.push_layer(test_bounds(0.));
+        scene.insert_primitive(test_shadow(0.));
+        scene.insert_primitive(test_blur(0., 4.));
+        scene.insert_primitive(test_quad(0.));
+        scene.pop_layer();
+
+        // Overlapping second layer takes draw order 2.
+        scene.push_layer(test_bounds(50.));
+        scene.insert_primitive(test_blur(50., 12.));
+        scene.insert_primitive(test_quad(50.));
+        scene.pop_layer();
+
+        scene.finish();
+
+        assert_eq!(scene.blur_rects.len(), 2);
+        assert!(scene.blur_rects[0].order < scene.blur_rects[1].order);
+
+        assert_eq!(
+            batch_summary(&scene),
+            vec![
+                "shadows:1".to_string(),
+                format!("blurs:1:{:?}", scaled(4.)),
+                "quads:1".to_string(),
+                format!("blurs:1:{:?}", scaled(12.)),
+                "quads:1".to_string(),
+            ]
+        );
+    }
+
+    #[test]
+    fn blur_rects_with_empty_clipped_bounds_are_skipped() {
+        let mut scene = Scene::default();
+
+        let mut clipped = test_blur(0., 8.);
+        clipped.content_mask = ContentMask {
+            bounds: test_bounds(1000.),
+        };
+        scene.insert_primitive(clipped);
+
+        assert_eq!(scene.len(), 0);
+        assert!(scene.blur_rects.is_empty());
+
+        scene.insert_primitive(test_blur(0., 8.));
+        assert_eq!(scene.len(), 1);
+        assert_eq!(scene.blur_rects.len(), 1);
+        assert_eq!(scene.blur_rects[0].blur_radius, scaled(8.));
+    }
+}
