+        if blurs.is_empty() {
+            return Ok(());
+        }
+        let viewport_width = self.resources.width;
+        let viewport_height = self.resources.height;
+
+        // Keep only rects with a non-empty dilated snapshot region and find
+        // their union plus the batch's maximum radius.
