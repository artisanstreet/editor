+                &test_bounds(10., 10., 0., 0.),
+                ScaledPixels::from(8.),
+                1000,
+                1000
+            ),
+            Some(BlurCopyBox {
+                left: 0,
+                top: 0,
+                right: 34,
+                bottom: 34,
+            })
