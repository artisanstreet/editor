{
	"name": "@artisan/workspace",
	"version": "0.2.2",
	"private": true,
	"license": "SEE LICENSE IN LICENSE.md",
	"type": "module",
	"scripts": {
		"build": "node .scripts/build/runner.ts",
		"build:modules": "node .scripts/build/build-modules.ts",
		"check": "tsc --noEmit",
		"check:frontend": "pnpm --filter @artisan/frontend run build",
		"check:forge": "node .scripts/build/build-forge.ts validation",
		"build:forge:sea": "node .scripts/build/build-forge.ts production",
		"bazel:forge": "bazelisk build //:forge_sea",
		"bazel:verify": "bazelisk build //:verify",
		"build:desktop": "pnpm run check:frontend && vite build --config .config/desktop.vite.config.ts && node .scripts/build/build-forge.ts production",
		"build:native": "cargo build --workspace --release",
		"check:native": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
		"desktop": "pnpm run build:desktop && electron .dist/desktop/main.js",
		"dev": "node .scripts/dev/runner.ts",
		"dev:doctor": "node .scripts/dev/runner.ts doctor",
		"dev:web": "node .scripts/dev/runner.ts web",
		"dev:ae": "node .scripts/dev/run-native.ts cli",
		"dev:ae-installer": "node .scripts/dev/run-native.ts installer",
		"dev:forge": "node .scripts/dev/runner.ts forge",
		"dev:open": "node .scripts/dev/runner.ts pair",
		"dev:pair": "node .scripts/dev/runner.ts pair",
		"package:desktop": "pnpm run build:desktop && electron-builder --config .config/desktop-builder.yml --win dir --publish never",
		"package:distribution:windows": "pnpm run build:native && pnpm run package:desktop && node .scripts/package/build-distribution-release-entry.ts",
		"verify:desktop-package": "node .tests/deep/desktop/verify-packaged-desktop.ts",
		"verify:distribution:windows": "vitest run --config .config/vitest.config.ts .tests/deep/distribution/windows-release-artifact.test.ts",
		"db:generate": "drizzle-kit generate --config .config/drizzle.config.ts",
		"db:compact": "node .scripts/maintenance/compact-database.ts",
		"format": "oxfmt --config .config/oxfmt.json --ignore-path .oxfmtignore .",
		"format:check": "oxfmt --check --config .config/oxfmt.json --ignore-path .oxfmtignore .",
		"format:check:frontend": "oxfmt --check --config .config/oxfmt.json --ignore-path .oxfmtignore modules/frontend .tests/frontend",
		"format:check:backend": "oxfmt --check --config .config/oxfmt.json --ignore-path .oxfmtignore modules/backend modules/catalog modules/engines modules/protocol .tests/backend .tests/catalog .tests/engines .tests/protocol",
		"format:check:forge": "oxfmt --check --config .config/oxfmt.json --ignore-path .oxfmtignore modules/forge .tests/forge .tests/deep/forge",
		"format:check:transport": "oxfmt --check --config .config/oxfmt.json --ignore-path .oxfmtignore modules/transport .tests/transport",
		"format:check:desktop": "oxfmt --check --config .config/oxfmt.json --ignore-path .oxfmtignore modules/desktop .config/desktop.vite.config.ts .config/desktop-builder.yml .tests/desktop .tests/build",
		"lint": "oxlint .",
		"lint:frontend": "oxlint modules/frontend .tests/frontend",
		"lint:backend": "oxlint modules/backend modules/catalog modules/engines modules/protocol .tests/backend .tests/catalog .tests/engines .tests/protocol",
		"lint:forge": "oxlint modules/forge .tests/forge .tests/deep/forge",
		"lint:transport": "oxlint modules/transport .tests/transport",
		"lint:desktop": "oxlint modules/desktop .config/desktop.vite.config.ts .tests/desktop .tests/build",
		"test": "vitest run --config .config/vitest.config.ts && pnpm --filter @artisan/dev-tui run test && pnpm --filter @artisanstreet/checklist run test",
		"test:focus": "vitest run --config .config/vitest.config.ts",
		"test:frontend": "pnpm run test:focus .tests/frontend",
		"test:backend": "pnpm run test:focus .tests/backend .tests/catalog .tests/engines .tests/protocol",
		"test:forge": "pnpm run test:focus .tests/forge .tests/deep/forge",
		"test:transport": "pnpm run test:focus .tests/transport",
		"test:desktop": "pnpm run test:focus .tests/desktop .tests/build",
		"test:bazel": "pnpm run check:frontend && pnpm run check:forge && pnpm run test",
		"test:native": "cargo test --workspace",
		"test:watch": "vitest --config .config/vitest.config.ts",
		"check:desktop": "vite build --config .config/desktop.vite.config.ts",
		"validate": "node .scripts/validate/runner.ts",
		"validate:full": "node .scripts/validate/runner.ts full",
		"validate:frontend": "node .scripts/validate/runner.ts frontend",
		"validate:backend": "node .scripts/validate/runner.ts backend",
		"validate:forge": "node .scripts/validate/runner.ts forge",
		"validate:transport": "node .scripts/validate/runner.ts transport",
		"validate:desktop": "node .scripts/validate/runner.ts desktop",
		"validate:native": "node .scripts/validate/runner.ts native"
	},
	"devDependencies": {
		"@artisan/backend": "workspace:*",
		"@artisan/catalog": "workspace:*",
		"@artisan/cli": "workspace:*",
		"@artisan/desktop": "workspace:*",
		"@artisan/dev-tui": "workspace:*",
		"@artisan/distribution": "workspace:*",
		"@artisan/engines": "workspace:*",
		"@artisan/forge": "workspace:*",
		"@artisan/protocol": "workspace:*",
		"@artisan/transport": "workspace:*",
		"@artisanstreet/checklist": "workspace:*",
		"@artisanstreet/runner": "git+https://github.com/sandersonstabo/runner.git#5b48d0d4cbddb310853aa8a413a7569cac850893",
		"@bazel/bazelisk": "1.28.1",
		"@effect/platform-node-shared": "4.0.0-beta.97",
		"@effect/vitest": "4.0.0-beta.97",
		"@electron/asar": "3.4.1",
		"@types/node": "26.1.1",
		"@types/ws": "8.18.1",
		"@types/yazl": "^3.3.1",
		"@vitest/runner": "4.1.10",
		"artisan-editor": "workspace:*",
		"bun": "1.3.14",
		"drizzle-kit": "1.0.0-rc.4",
		"effect": "4.0.0-beta.97",
		"electron": "43.1.1",
		"electron-builder": "26.15.3",
		"es-module-lexer": "2.3.0",
		"oxfmt": "0.58.0",
		"oxlint": "1.73.0",
		"portless": "0.15.5",
		"postject": "1.0.0-alpha.6",
		"resedit": "^3.0.2",
		"rolldown": "1.1.5",
		"typescript": "7.0.2",
		"vite": "8.1.4",
		"vitest": "4.1.10",
		"ws": "8.21.0",
		"yazl": "^3.3.1"
	},
	"packageManager": "pnpm@11.7.0"
}
