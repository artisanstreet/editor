{
	"name": "artisan-editor",
	"private": true,
	"type": "module",
	"scripts": {
		"check": "tsc --noEmit",
		"db:generate": "drizzle-kit generate --config drizzle.config.ts",
		"format": "oxfmt --ignore-path .oxfmtignore .",
		"format:check": "oxfmt --check --ignore-path .oxfmtignore .",
		"lint": "oxlint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"validate": "pnpm run format:check && pnpm run lint && pnpm run check && pnpm run test"
	},
	"devDependencies": {
		"@artisan/backend": "workspace:*",
		"@artisan/protocol": "workspace:*",
		"@types/node": "26.1.1",
		"drizzle-kit": "1.0.0-rc.4",
		"effect": "4.0.0-beta.97",
		"oxfmt": "0.58.0",
		"oxlint": "1.73.0",
		"typescript": "7.0.2",
		"vitest": "4.1.10"
	},
	"packageManager": "pnpm@11.7.0"
}
