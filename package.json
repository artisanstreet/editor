{
	"name": "@artisan/workspace",
	"version": "0.2.2",
	"private": true,
	"type": "module",
	"scripts": {
		"check": "tsc --noEmit",
		"check:frontend": "pnpm --filter @artisan/frontend run build",
		"check:forge": "node .scripts/build/build-forge.ts validation",
		"build:desktop": "pnpm run check:frontend && vite build --config desktop.vite.config.ts && node .scripts/build/build-forge.ts production",
		"build:native": "cargo build --workspace --release",
		"check:native": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
		"desktop": "pnpm run build:desktop && electron .dist/desktop/main.js",
		"dev": "node .scripts/dev/runner.ts",
		"dev:doctor": "node .scripts/dev/runner.ts doctor",
		"dev:web": "node .scripts/dev/runner.ts web",
		"dev:ae": "powershell -NoProfile -ExecutionPolicy Bypass -File .scripts/dev/run-dev-ae.ps1",
		"dev:ae-installer": "powershell -NoProfile -ExecutionPolicy Bypass -File .scripts/dev/run-dev-ae-installer.ps1",
		"dev:forge": "node .scripts/dev/runner.ts forge",
		"dev:open": "node .scripts/dev/runner.ts pair",
		"dev:pair": "node .scripts/dev/runner.ts pair",
		"package:desktop": "pnpm run build:desktop && electron-builder --config desktop-builder.yml --win dir --publish never",
		"package:distribution:windows": "pnpm run build:native && pnpm run package:desktop && node .scripts/package/build-distribution-release-entry.ts",
		"verify:desktop-package": "powershell -NoProfile -ExecutionPolicy Bypass -File .tests/deep/desktop/verify-packaged-desktop.ps1",
		"verify:distribution:windows": "vitest run .tests/deep/distribution/windows-release-artifact.test.ts",
		"db:generate": "drizzle-kit generate --config drizzle.config.ts",
		"format": "oxfmt --ignore-path .oxfmtignore .",
		"format:check": "oxfmt --check --ignore-path .oxfmtignore .",
		"lint": "oxlint .",
		"test": "vitest run && pnpm --filter @artisan/dev-tui run test",
		"test:native": "cargo test --workspace",
		"test:watch": "vitest",
		"validate": "pnpm run format:check && pnpm run lint && pnpm run check && pnpm run check:frontend && pnpm run check:forge && pnpm run test && pnpm run check:native && pnpm run test:native"
	},
	"devDependencies": {
		"@anthropic-ai/claude-agent-sdk": "0.3.222",
		"@artisan/backend": "workspace:*",
		"@artisan/catalog": "workspace:*",
		"@artisan/cli": "workspace:*",
		"@artisan/desktop": "workspace:*",
		"@artisan/dev-tui": "workspace:*",
		"@artisan/distribution": "workspace:*",
		"@artisan/engines": "workspace:*",
		"@artisan/forge": "workspace:*",
		"@artisan/protocol": "workspace:*",
		"@artisan/transport": "workspace:*",
		"@effect/platform-node-shared": "4.0.0-beta.97",
		"@effect/vitest": "4.0.0-beta.97",
		"@electron/asar": "3.4.1",
		"@types/node": "26.1.1",
		"@types/ws": "8.18.1",
		"@types/yazl": "^3.3.1",
		"artisan-editor": "workspace:*",
		"bun": "1.3.14",
		"drizzle-kit": "1.0.0-rc.4",
		"effect": "4.0.0-beta.97",
		"electron": "43.1.1",
		"electron-builder": "26.15.3",
		"es-module-lexer": "2.3.0",
		"oxfmt": "0.58.0",
		"oxlint": "1.73.0",
		"portless": "0.15.5",
		"rolldown": "1.1.5",
		"typescript": "7.0.2",
		"vite": "8.1.4",
		"vitest": "4.1.10",
		"ws": "8.21.0",
		"yazl": "^3.3.1"
	},
	"packageManager": "pnpm@11.7.0"
}
