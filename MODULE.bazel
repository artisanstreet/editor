module(
    name = "artisan_editor",
    version = "0.2.2",
)

bazel_dep(name = "aspect_rules_js", version = "3.4.0")
bazel_dep(name = "rules_nodejs", version = "6.7.5")

# bazel-lib 3.7 shells out through Bash when rules_js applies pnpm patches in a
# package subdirectory. Keep repository patching native on Windows so Bash does
# not become the action shell and rewrite drive paths into MSYS form.
single_version_override(
    module_name = "bazel_lib",
    patch_strip = 1,
    patches = ["//tools/bazel:bazel-lib-windows-native-patch.patch"],
    version = "3.7.0",
)

# Node is pinned independently of the host runtime. pnpm reads the exact
# pnpm@11.7.0 packageManager pin from the root package manifest.
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "24.18.0")
use_repo(node, "nodejs_toolchains")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(pnpm_version_from = "//:package.json")
use_repo(pnpm, "pnpm")

# The pnpm lockfile remains the source of truth for every JavaScript package,
# including workspace links and repository-owned dependency patches.
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
    data = [
        "//:patches/@effect__platform-node-shared@4.0.0-beta.97.patch",
        "//:patches/pe-library@2.0.1.patch",
    ],
    run_lifecycle_hooks = False,
)
# SvelteKit reads its synthetic `$env` Markdown descriptions while generating
# ambient types, so this package cannot use rules_js's default `*.md` pruning.
npm.npm_exclude_package_contents(
    package = "@sveltejs/kit",
    presets = [],
)
use_repo(npm, "npm")
