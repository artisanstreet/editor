load(
    "@rules_rust//rust:defs.bzl",
    "rust_binary",
    "rust_clippy",
    "rust_test",
    "rustfmt_test",
)
load("//packaging/release:release_manifest.bzl", "release_manifest")

exports_files(
    [
        "release_manifest.bzl",
        "rust/release_tool.rs",
    ],
    visibility = ["//tests/packaging:__pkg__"],
)

filegroup(
    name = "release_build_source",
    srcs = ["BUILD.bazel"],
    visibility = ["//tests/packaging:__pkg__"],
)

rust_binary(
    name = "release_tool",
    srcs = ["rust/release_tool.rs"],
    crate_name = "release_tool",
    deps = [
        "@crates//:base64",
        "@crates//:ed25519-dalek",
        "@crates//:semver",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2-0.11.0",
        "@crates//:zeroize",
        "@crates//:zip",
    ],
    edition = "2024",
    lint_config = "//:workspace_lints",
    visibility = ["//visibility:public"],
)

release_manifest(
    name = "development_release_manifest",
    archive = "//packaging/portable:versioned_payload_archive",
    format_version = 1,
    product_version = "0.0.0",
    editor_forge_compatibility_version = "0.0.0",
    channel = "nightly",
    signing_key_id = "development",
    algorithm = "ed25519",
    minimum_installer_version = "0.0.0",
    minimum_cli_version = "0.0.0",
    artifact_id = "windows-x64",
    platform = "windows",
    architecture = "x64",
    libc = "",
    archive_format = "zip",
    file_name = "artisan-editor-versioned-payload.zip",
    output_name = "release-manifest.json",
    visibility = ["//visibility:public"],
)

# This target exercises the production binary's cfg(test) suite. It is a
# package-local proof; root aggregate registration remains VP-owned.
rust_test(
    name = "release_tool_test",
    crate = ":release_tool",
    crate_name = "release_tool_test",
    edition = "2024",
    lint_config = "//:workspace_lints",
    size = "small",
    visibility = ["//:__pkg__"],
)

rust_clippy(
    name = "clippy",
    testonly = True,
    deps = [
        ":release_tool",
        ":release_tool_test",
    ],
)

rustfmt_test(
    name = "format_test",
    size = "small",
    targets = [
        ":release_tool",
        ":release_tool_test",
    ],
    transitive = True,
)

test_suite(
    name = "tests",
    tests = [":release_tool_test"],
)
